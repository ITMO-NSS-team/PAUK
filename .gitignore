# pauk/gui/graph_builder/builder.py --out-dir (по умолчанию — pauk.settings.Settings.gui_dir, data/gui/<institution>):
# данные для сайта pauk/gui/web, private — полный, personal-поля включены;
# public — урезанный вариант для сборки вне корпоративной сети (пока не подключён к сайту).
data/gui/*

docs/reports/*

*.egg-info/
dist/
build/

.env

.DS_Store

.vscode/
.idea/
*.swp
*.swo

logs/

graphify-out/
.graphifyignore
.coverage

# Database dumps and pre-write snapshots — large, never committed.
data/backups/
# Script output: plans, verdicts, unmatched rows. Regenerated from the data,
# so it is never the record of anything. What is worth keeping — a runbook, a
# list someone decided on — goes to docs/reports/ by hand.
data/reports/
docs/reports/

*.log
