# Secrets and per-host paths for deploy/compose.yml. The real file lives
# outside the repository (on the server: ~/pauk/secrets/pauk.env, mode 600)
# and is passed with --env-file. Compose hands each service only what it needs.

# Where things live on this host
PAUK_HOME=/home/asteb/pauk
PAUK_ESSDATA=/var/essdata/pauk
PAUK_STAND=itmo
# Owner of the files the PAUK containers write (`id -u`, `id -g` on the host)
PAUK_UID=1004
PAUK_GID=1004
# Memory; the defaults are sized for the lab server, lower them on a laptop
# MONGO_CACHE_GB=6
# NEO4J_HEAP=2g
# NEO4J_PAGECACHE=1g

# MongoDB: the root user creates the database; PAUK connects as the app user
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=
MONGO_DB=

# Neo4j
NEO4J_PASSWORD=

# External services
OPENALEX_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_PROXY_URL=http://<host>:<port>
# PAUK_LLM_MODEL=
# Parallel LLM calls in the author_names and person resolution stages
# PAUK_AUTHOR_NAMES_CONCURRENCY=8
# PAUK_PERSON_RESOLUTION_CONCURRENCY=8
GITHUB_TOKEN=
# PDF-Crawler-Service runs outside this compose, on the host
# PAUK_PDF_CRAWLER_URL=http://host.docker.internal:8000/api/v1

# Admin panel: set to 1 only when it is served over TLS
# PAUK_ADMIN_SECURE_COOKIE=
