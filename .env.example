# Путь к БД (опционально, по умолчанию data/itmo_opensource.db)
# PAUK_DB_PATH=/custom/path/to/itmo_opensource.db

# Директория с данными (опционально, по умолчанию ./data)
# PAUK_DATA_DIR=/custom/path/to/data

# API-ключ OpenAlex
OPENALEX_API_KEY=

# API-ключ OpenRouter
OPENROUTER_API_KEY=

# Personal access token GitHub
GITHUB_TOKEN=

# Openreview account
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Neo4j — для pauk/graph (загрузка выхода пайплайна в графовую БД)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
