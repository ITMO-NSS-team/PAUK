# API-ключ OpenAlex
OPENALEX_API_KEY=

# API-ключ OpenRouter
OPENROUTER_API_KEY=
PAUK_LLM_MODEL=qwen/qwen-2.5-72b-instruct
# Person deduplication: LogReg confidence gates plus two Qwen checks.
PAUK_PERSON_RESOLUTION_ENABLED=true
PAUK_PERSON_RESOLUTION_MODEL=qwen/qwen3-next-80b-a3b-instruct
PAUK_PERSON_RESOLUTION_LOGREG_MODEL_PATH=pauk/graph/artifacts/person_resolution_logreg.pkl
PAUK_PERSON_RESOLUTION_CONCURRENCY=8
PAUK_PERSON_RESOLUTION_SEPARATE_BELOW=0.05
PAUK_PERSON_RESOLUTION_MERGE_FROM=0.99

# Proxy for OpenRouter
# OPENROUTER_PROXY_URL=http://<host>:<port>

# Personal access token GitHub
GITHUB_TOKEN=

# Openreview account
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# PAUK_DATA_DIR=/custom/path/to/data
# PAUK_REQUEST_TIMEOUT=30

# PDF-Crawler-Service (https://github.com/gurinboru/PDF-Crawler-Service)
# PAUK_PDF_CRAWLER_URL=http://<host>:<port>/api/v1

# Neo4j
NEO4J_URI=bolt://<host>
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MongoDB
MONGO_URI=mongodb://<host>:27017
MONGO_DB=pauk
