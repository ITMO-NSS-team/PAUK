# API-key OpenAlex
OPENALEX_API_KEY=

# Indexing API limits requests per second
# PAUK_OPENALEX_RPS=30
# PAUK_ORCID_RPS=12
# PAUK_CROSSREF_RPS=10
# PAUK_CROSSREF_CONCURRENCY=3
# Crossref uses the public pool without a contact email 5 rps
CROSSREF_MAILTO=

# API-key OpenRouter
OPENROUTER_API_KEY=

# LLM overrides; defaults live in pauk/settings.py
# PAUK_LLM_MODEL=
# PAUK_PERSON_RESOLUTION_MODEL=
# PAUK_REPORTS_MODEL=
# PAUK_CLAUDE_CLI_MODEL=
# PAUK_CODEX_CLI_MODEL=

# Proxy for OpenRouter
# OPENROUTER_PROXY_URL=http://<host>:<port>

# LLM provider: openrouter, or a subscription CLI: claude[:<model>], codex[:<model>]
# PAUK_LLM_PROVIDER=openrouter
# PAUK_LINK_RELEVANCE_PROVIDER=
# PAUK_AUTHOR_NAMES_PROVIDER=
# PAUK_PERSON_RESOLUTION_PROVIDER=

# Personal access token GitHub
GITHUB_TOKEN=

# PAUK_DATA_DIR=/custom/path/to/data
# PAUK_REPORTS_DIR=/custom/path/to/reports
# PAUK_REQUEST_TIMEOUT=30

# PDF-Crawler-Service (https://github.com/gurinboru/PDF-Crawler-Service)
# PAUK_PDF_CRAWLER_URL=http://<host>:<port>/api/v1

# Neo4j
NEO4J_URI=bolt://<host>
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MongoDB
MONGO_URI=mongodb://<host>:27017
MONGO_DB=pauk
