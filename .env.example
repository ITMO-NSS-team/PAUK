# University to collect: itmo (default) or ufjf (pauk/institution.py).
# Each one needs its own MongoDB database and its own Neo4j instance.
# PAUK_INSTITUTION=itmo

# API-key OpenAlex
OPENALEX_API_KEY=

# API-key OpenRouter
OPENROUTER_API_KEY=
PAUK_LLM_MODEL=anthropic/claude-haiku-5.5

# Proxy for OpenRouter
# OPENROUTER_PROXY_URL=http://<host>:<port>

# Personal access token GitHub
GITHUB_TOKEN=

# ORCID public API client (orcid.org > Developer Tools): 100,000 reads a day
# instead of 25,000 per IP address.
# ORCID_CLIENT_ID=
# ORCID_CLIENT_SECRET=

# Threads for the persons and code_links stages (requests stay inside each
# API's limit through the shared per-host rate limiter).
# PAUK_PERSONS_CONCURRENCY=8
# PAUK_CODE_LINKS_CONCURRENCY=8
# Crossref ORCID backfill by surname, off by default.
# PAUK_CROSSREF_ENABLED=false

# PAUK_DATA_DIR=/custom/path/to/data
# PAUK_REQUEST_TIMEOUT=30

# PDF-Crawler-Service (https://github.com/gurinboru/PDF-Crawler-Service)
# PAUK_PDF_CRAWLER_URL=http://<host>:<port>/api/v1

# Neo4j
NEO4J_URI=bolt://<host>
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MongoDB
MONGO_URI=mongodb://<host>:27017
# Empty: the university's own database (pauk for itmo, pauk_ufjf for ufjf).
# MONGO_DB=pauk
