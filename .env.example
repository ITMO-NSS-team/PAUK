# API-ключ OpenAlex.
OPENALEX_API_KEY=

# API-ключ OpenRouter.
OPENROUTER_API_KEY=

# Контактный email для User-Agent (попадает в OpenAlex polite-pool).
USER_AGENT_EMAIL=

# Имя модели на OpenRouter. Опционально, по умолчанию openai/gpt-4o-mini.
# Полный список: https://openrouter.ai/models
LLM_MODEL=

# S3-совместимое хранилище препринтов (arXiv/bioRxiv/medRxiv) —
# дополнительный источник PDF для fetch_pdfs_s3.py. Если не задано,
# скрипт просто ничего не делает.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Регион для подписи S3v4. Опционально, по умолчанию us-east-1.
S3_REGION=
